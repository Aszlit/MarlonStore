<Window x:Class="Inventory.UserControls.AddNewItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Add New Item" 
        Height="450" 
        Width="400" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border Background="#FF3C3C3C" CornerRadius="10">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Custom Title Bar -->
            <DockPanel Background="Transparent" Height="40" VerticalAlignment="Top" Margin="0">
                <TextBlock Text="Add New Item" VerticalAlignment="Center" Foreground="White" FontSize="16" FontWeight="Bold" Margin="10,0,0,0"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <!-- Close Button -->
                    <Button Width="30" Height="30" Background="Transparent" BorderThickness="0" 
                            Click="CloseApp" ToolTip="Close">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- Background Layer -->
                                    <Rectangle x:Name="BackgroundRectangle" Fill="Transparent" RadiusX="5" RadiusY="5"/>
                                    <!-- X Icon -->
                                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="White" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- MouseOver Trigger -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BackgroundRectangle" Property="Fill" Value="#FFCC0000"/>
                                        <!-- Red Hover Background -->
                                    </Trigger>
                                    <!-- Pressed Trigger -->
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BackgroundRectangle" Property="Fill" Value="#FF990000"/>
                                        <!-- Darker Red Click Background -->
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Form Content -->
            <StackPanel Grid.Row="1" Margin="0,230,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="340" Height="101">
                <!-- Item Name -->
                <!-- Item Name -->
                <!-- Item Name -->
                <!-- Item Name -->

                <!-- Item Name -->

                <!-- Item Name -->

                <!-- Item Name -->

                <!-- Item Name -->
                <!-- Quantity -->

                <!-- Price -->

                <!-- Value -->

                <!-- Category -->
                <TextBlock Text="Category:" VerticalAlignment="Center" Foreground="White" Margin="0,0,0,5"/>
                <StackPanel x:Name="CategoryPanel" Orientation="Vertical" Margin="0,0,0,15" Width="341" Height="81">
                    <RadioButton Content="Frozen Foods" GroupName="Category" Margin="0,5"/>
                    <RadioButton Content="General Products" GroupName="Category" Margin="0,5"/>
                    <RadioButton Content="Liquior" GroupName="Category" Margin="0,5"/>
                    <RadioButton Content="Liquior" GroupName="Category" Margin="0,5"/>
                </StackPanel>

                <!-- Image Preview -->
                <Image x:Name="PreviewImage" Width="100" Height="100" Margin="0,0,0,15" HorizontalAlignment="Center" Stretch="Uniform"/>

                <!-- Select Image Button -->
                <Button Content="Select Image" Margin="0,0,0,15" Width="150" HorizontalAlignment="Center"
                        Click="SelectImage_Click" Background="#FF1E90FF" Foreground="White" BorderThickness="0" FontFamily="Bahnschrift SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <!-- Background Layer -->
                                <Rectangle x:Name="BackgroundRectangle" Fill="#FF1E90FF" RadiusX="5" RadiusY="5"/>
                                <!-- Button Content -->
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- MouseOver Trigger -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BackgroundRectangle" Property="Fill" Value="#FF4682B4"/>
                                    <!-- Lighter Blue Hover Background -->
                                </Trigger>
                                <!-- Pressed Trigger -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BackgroundRectangle" Property="Fill" Value="#FF4169E1"/>
                                    <!-- Darker Blue Click Background -->
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Add Image Button -->
                <Button Content="Add Image" Margin="0,0,0,15" Width="150" HorizontalAlignment="Center"
                        Click="SelectImage_Click" Background="#FF1E90FF" Foreground="White" BorderThickness="0" FontFamily="Bahnschrift SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <!-- Background Layer -->
                                <Rectangle x:Name="BackgroundRectangle" Fill="#FF1E90FF" RadiusX="5" RadiusY="5"/>
                                <!-- Button Content -->
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- MouseOver Trigger -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BackgroundRectangle" Property="Fill" Value="#FF4682B4"/>
                                    <!-- Lighter Blue Hover Background -->
                                </Trigger>
                                <!-- Pressed Trigger -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BackgroundRectangle" Property="Fill" Value="#FF4169E1"/>
                                    <!-- Darker Blue Click Background -->
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <!-- Save Button -->
                <Button Content="Save" Width="100" Margin="10,0,0,0"
                        Click="SaveButton_Click" Background="#FF1E90FF" Foreground="White" BorderThickness="0" FontFamily="Bahnschrift SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Background Layer -->
                                <Rectangle x:Name="BackgroundRectangle" Fill="#FF1E90FF" RadiusX="5" RadiusY="5"/>
                                <!-- Button Content -->
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- MouseOver Trigger -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BackgroundRectangle" Property="Fill" Value="#FF4682B4"/>
                                    <!-- Lighter Blue Hover Background -->
                                </Trigger>
                                <!-- Pressed Trigger -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BackgroundRectangle" Property="Fill" Value="#FF4169E1"/>
                                    <!-- Darker Blue Click Background -->
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Cancel Button -->
                <Button Content="Cancel" Width="100" Margin="10,0,0,0"
                        Click="CancelButton_Click" Background="#FF1E90FF" Foreground="White" BorderThickness="0" FontFamily="Bahnschrift SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Background Layer -->
                                <Rectangle x:Name="BackgroundRectangle" Fill="#FF1E90FF" RadiusX="5" RadiusY="5"/>
                                <!-- Button Content -->
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- MouseOver Trigger -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BackgroundRectangle" Property="Fill" Value="#FF4682B4"/>
                                    <!-- Lighter Blue Hover Background -->
                                </Trigger>
                                <!-- Pressed Trigger -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BackgroundRectangle" Property="Fill" Value="#FF4169E1"/>
                                    <!-- Darker Blue Click Background -->
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
            <Button x:Name="insertimage_button" Content="Insert Image" HorizontalAlignment="Left" Margin="230,145,0,0" Grid.Row="1" VerticalAlignment="Top" Height="30" Width="112" Click="InsertImageButton_Click"/>
            <Image x:Name="image_box" HorizontalAlignment="Left" Height="100" Margin="236,33,0,0" VerticalAlignment="Top" Width="100" Grid.Row="1"/>
            <TextBlock Text="Item Name:" Foreground="White" Margin="15,17,159,303" Grid.Row="1"/>
            <TextBox x:Name="ItemNameTextBox" Margin="40,33,159,285" Grid.Row="1"/>
            <TextBlock Text="Quantity:" Foreground="White" Margin="15,66,159,254" Grid.Row="1"/>
            <xctk:IntegerUpDown x:Name="QuantityTextBox" Minimum="0" Maximum="1000" Increment="1" ValueChanged="QuantityOrPrice_ValueChanged" Margin="40,87,159,229" Grid.Row="1"/>
            <TextBlock Text="Price:" Foreground="White" Margin="15,122,230,198" Grid.Row="1"/>
            <xctk:IntegerUpDown x:Name="PriceTextBox" Minimum="0" Maximum="1000000" Increment="1" ValueChanged="QuantityOrPrice_ValueChanged" Margin="40,143,205,173" Grid.Row="1"/>
            <TextBlock Text="Value:" Foreground="White" Margin="15,177,230,144" Grid.Row="1" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="0.746"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBox x:Name="ValueTextBox" IsReadOnly="True" Margin="40,199,205,119" Grid.Row="1"/>
        </Grid>
    </Border>
</Window>
